# ============================================================
# すし割烹 いづ浦 — 環境変数テンプレート
# このファイルをコピーして .env を作成し、値を設定してください。
# cp .env.example .env
# ============================================================

# ── Database (Neon PostgreSQL) ───────────────────────────────
# Vercel サーバーレス環境では「接続プーラー URL」を使用してください。
# Neon ダッシュボード → Connection Details → Pooled connection
# 末尾に ?pgbouncer=true&connection_limit=1&sslmode=require を付与
DATABASE_URL="postgresql://user:password@ep-xxx-yyy-pooler.ap-southeast-1.aws.neon.tech/dbname?pgbouncer=true&connection_limit=1&sslmode=require"

# ── Authentication (nuxt-auth-utils) ─────────────────────────
# 最低32文字以上のランダムな文字列。以下のコマンドで生成可能：
# openssl rand -hex 32
NUXT_SESSION_PASSWORD="ここに32文字以上のランダムな文字列を設定してください"

# ── Email (Resend) ───────────────────────────────────────────
# https://resend.com でAPIキーを取得
# 送信ドメイン（izuura.com）をResendで認証済みにすること
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
MAIL_FROM_ADDRESS="noreply@izuura.com"
MAIL_ADMIN_ADDRESS="admin@izuura.com"

# ── Stripe ───────────────────────────────────────────────────
# https://dashboard.stripe.com でキーを取得
# テスト環境: sk_test_ / pk_test_
# 本番環境:   sk_live_ / pk_live_
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
# Stripeダッシュボード → Webhooks → エンドポイント追加後に取得
# Webhook URL: https://your-domain.vercel.app/api/stripe/webhook
# 受信イベント: checkout.session.completed
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"
